            <!-- Video Processing Settings -->
            <Border Background="White" 
                    BorderBrush="#DEE2E6" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Video Processing Settings" 
                               FontSize="18" FontWeight="SemiBold" 
                               Margin="0,0,0,10"
                               Foreground="#212121"/>
                    <TextBlock Text="Customize FFmpeg commands and video processing parameters. Settings are stored in video-settings.yaml file." 
                               FontSize="14" 
                               Foreground="#6C757D"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Reset Video Processing Settings" 
                                Style="{StaticResource ModernButton}"
                                Click="ResetVideoProcessingSettings_Click"
                                Background="#DC3545"
                                Margin="0,0,10,0"/>
                        <Button Content="Open Settings File" 
                                Style="{StaticResource ModernButton}"
                                Click="OpenVideoSettingsFile_Click"
                                Background="#28A745"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            </StackPanel>
            
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Style="{StaticResource CancelButton}"
                    Click="CancelButton_Click"/>
            <Button Content="Save" 
                    Style="{StaticResource ModernButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 