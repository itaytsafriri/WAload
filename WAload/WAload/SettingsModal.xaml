                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Folder Sorting" 
                                   FontSize="18" FontWeight="SemiBold" 
                                   Margin="0,0,0,5"
                                   Foreground="#212121"/>
                        <TextBlock Text="Organize media files into folders based on sender names found in message text (when text contains _name)" 
                                   FontSize="14" 
                                   Foreground="#6C757D"
                                   TextWrapping="Wrap"/>
