<Window x:Class="WAload.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename File" 
        Height="280" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontSize="14" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004578"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#495057"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon and Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📝" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Rename File" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#343A40"/>
        </StackPanel>

        <!-- Current filename display -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Current name:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,3"/>
            <TextBlock x:Name="CurrentFileNameText" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#495057"/>
        </StackPanel>

        <!-- New filename input -->
        <StackPanel Grid.Row="2" Margin="0,0,0,25">
            <TextBlock Text="New name:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,5"/>
            <TextBox x:Name="NewFileNameTextBox" 
                     Height="80" 
                     Padding="10,8"
                     BorderBrush="#CED4DA" 
                     BorderThickness="1"
                     FontSize="14"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Style="{StaticResource CancelButton}"
                    Click="CancelButton_Click"/>
            <Button Content="Rename" 
                    Style="{StaticResource ModernButton}"
                    Click="RenameButton_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
